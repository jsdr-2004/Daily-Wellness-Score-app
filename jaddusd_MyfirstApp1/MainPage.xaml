<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="jaddusd_MyfirstApp1.MainPage"
             Title="Daily Wellness"
             BackgroundColor="#F6F7FB"
             Padding="16">

    <ScrollView>
        <VerticalStackLayout Spacing="20">

            <Label Text="Daily Wellness Score"
                   FontSize="26"
                   FontAttributes="Bold"/>

            <!-- Gender Selection -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="14">

                <Frame x:Name="MaleCard"
                       Padding="12"
                       CornerRadius="18"
                       HasShadow="True">
                    <VerticalStackLayout HorizontalOptions="Center">
                        <Image Source="male.png"
                               HeightRequest="100"
                               WidthRequest="100">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnMaleTapped"/>
                            </Image.GestureRecognizers>
                        </Image>
                        <Label Text="Male" FontAttributes="Bold"/>
                    </VerticalStackLayout>
                </Frame>

                <Frame x:Name="FemaleCard"
                       Grid.Column="1"
                       Padding="12"
                       CornerRadius="18"
                       HasShadow="True">
                    <VerticalStackLayout HorizontalOptions="Center">
                        <Image Source="female.png"
                               HeightRequest="100"
                               WidthRequest="100">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnFemaleTapped"/>
                            </Image.GestureRecognizers>
                        </Image>
                        <Label Text="Female" FontAttributes="Bold"/>
                    </VerticalStackLayout>
                </Frame>

            </Grid>

            <!-- Sleep -->
            <Label Text="Sleep Hours"/>
            <Slider x:Name="SleepSlider"
                    Minimum="0"
                    Maximum="12"
                    Value="7"
                    ValueChanged="OnSliderChanged"/>
            <Label x:Name="SleepValueLabel" Text="7.0 h"/>

            <!-- Stress -->
            <Label Text="Stress Level"/>
            <Slider x:Name="StressSlider"
                    Minimum="0"
                    Maximum="10"
                    Value="4"
                    ValueChanged="OnSliderChanged"/>
            <Label x:Name="StressValueLabel" Text="4.0 / 10"/>

            <!-- Activity -->
            <Label Text="Activity Minutes"/>
            <Slider x:Name="ActivitySlider"
                    Minimum="0"
                    Maximum="120"
                    Value="30"
                    ValueChanged="OnSliderChanged"/>
            <Label x:Name="ActivityValueLabel" Text="30 min"/>

            <Button Text="Next"
                    BackgroundColor="#2563EB"
                    TextColor="White"
                    CornerRadius="18"
                    Clicked="OnNextClicked"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
