<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="jaddusd_MyfirstApp1.RecommendationsPage"
             Title="Recommendations"
             BackgroundColor="#F6F7FB"
             Padding="20">

    <ScrollView>
        <VerticalStackLayout Spacing="20">

            <Label Text="Your Recommendations"
                   FontSize="22"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"/>

            <Label x:Name="RecommendationLabel"
                   FontSize="16"/>

            <Button Text="Back to Results"
                    Clicked="OnBackResults"/>

            <Button Text="Back to Inputs"
                    Clicked="OnBackInputs"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
